# Claude Code transient agent worktrees (qa-evaluator isolation)
.claude/worktrees/

# Environment & secrets
.env
!.env.example
.env.local
service-account.json
*.pem

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.venv*/
*.egg

# Node
node_modules/
.next/
# Isolated Next build dirs used by the skip-auth Playwright rig
# (PLAYWRIGHT_DIST_DIR in next.config.js -- never share `.next` with the
# operator's live :3000 dev server).
.next-*/

# Logs
*.log
logs/

# Data files
*.db
tickets.db

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo

# Prisma SQLite auth database
frontend/prisma/auth.db
frontend/prisma/auth.db-journal

# Generated files
_backend.log
_frontend.log
_restart_log.txt
_health_result.txt
_cleanup.ps1

# Archived/stale
pyfinagent-app/.streamlit/secrets.toml

# Secrets backups
backend/.env.env.bak-*
backend/.env.*.bak-*
*.env.bak-*
backend/.env.bak*

# Playwright Chrome binary (installed by `playwright install`)
frontend/chrome/

# goal-browser-mcp: Playwright MCP persistent profile (cookies/login state for the
# browser-driving MCP; never commit -- may hold a logged-in session)
.playwright-mcp-profile/
# goal-browser-mcp: Playwright MCP run output (console logs + page DOM snapshots)
.playwright-mcp/
# goal-browser-mcp: loose verification screenshots saved to repo root by the MCP
cockpit-*.png

# phase-4.16.2: runtime logs (moved to handoff/logs/) are not committed
handoff/logs/
handoff/*.log

# phase-10.10 quarantine dirs (local forensic archive, not pushed to remote)
handoff/archive/_quarantine_*/
.claude/_backups_archive/

# Coverage artifacts (cycle 53; .coveragerc + docs/coverage_tier_overrides.md are tracked)
.coverage
.coverage.*
.coverage_html/
htmlcov/
handoff/.away-session.lock

# TypeScript incremental build cache (tsc --noEmit side-effect; phase-71.1)
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo
handoff/.autonomous_loop.lock

# cwd-derived Claude Code agent-memory forks (phase-84 audit 2026-08-06):
# sessions started from a subdir create empty <subdir>/.claude/agent-memory roots
# that the real index at .claude/agent-memory/ never sees. Root corpus stays tracked.
/frontend/.claude/
/backend/.claude/
