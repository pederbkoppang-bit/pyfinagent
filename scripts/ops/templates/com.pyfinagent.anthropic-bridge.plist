<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- phase-76.9.2 TEMPLATE (NOT auto-installed; the 62.0 rail blocks launchctl
     bootstrap from agent sessions by design). Operator token OPS-BRIDGE-BOOTSTRAP:

       cp scripts/ops/templates/com.pyfinagent.anthropic-bridge.plist \
          ~/Library/LaunchAgents/com.pyfinagent.anthropic-bridge.plist
       launchctl bootstrap gui/$(id -u) \
          ~/Library/LaunchAgents/com.pyfinagent.anthropic-bridge.plist

     The bridge serves http://127.0.0.1:18797 -> https://localhost:18796
     (claude-code-proxy -> claude -p on the Max plan). See
     scripts/ops/anthropic_max_bridge.py header for the full rationale. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pyfinagent.anthropic-bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/ford/.openclaw/workspace/pyfinagent/.venv/bin/python</string>
        <string>/Users/ford/.openclaw/workspace/pyfinagent/scripts/ops/anthropic_max_bridge.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- phase-79.5 FIX (MEASURED 2026-07-25, not assumed): this was
         <dict><key>SuccessfulExit</key><false/></dict>, i.e. "restart only on an
         unsuccessful exit". Tested live after bootstrap: `kill -9` the bridge and
         launchd did NOT bring it back (`runs = 1`, `state = not running`, still dead
         after a 21s wait spanning the ~10s restart throttle). The operator would have
         bootstrapped this believing the bridge was durable, and it would have died
         silently at the first crash -- taking the nightly with it once
         AUTORESEARCH_USE_MAX_RAIL=1 is set (run_nightly.sh then exits 78 and pages).
         KeepAlive=true is the correct semantic for an always-on local daemon:
         restart unconditionally, whatever the exit reason. -->
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/ford/.openclaw/workspace/pyfinagent/handoff/logs/anthropic-bridge.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ford/.openclaw/workspace/pyfinagent/handoff/logs/anthropic-bridge.log</string>
    <key>WorkingDirectory</key>
    <string>/Users/ford/.openclaw/workspace/pyfinagent</string>
</dict>
</plist>
